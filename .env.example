# Salin ke .env lalu isi. File .env tidak ikut git.
# Env yang sudah diset di shell menang atas isi file ini.

# API pribadi kompatibel OpenAI. Boleh berakhir di /v1 atau /v1/chat/completions.
PURRFEED_LLM_URL=https://alamat-api-kamu/v1
PURRFEED_LLM_MODEL=nama-model
PURRFEED_LLM_KEY=isi-key-kamu

# Opsional
# PURRFEED_LLM_HEADERS={"X-Header": "nilai"}
# PURRFEED_LLM_TEMPERATURE=0.4
# PURRFEED_LLM_MAX_TOKENS=300
# PURRFEED_LLM_TIMEOUT=15
# PURRFEED_PERSONA=persona.md
